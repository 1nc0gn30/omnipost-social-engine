[Desktop Entry]
Version=1.0
Type=Application
Name=OmniPost Social Studio
GenericName=Multi-Platform Social Content Engine & Workstation
Comment=Multi-Platform Social Formatting, Thread Synthesis, Engagement Analytics & MCP Workstation
Exec=/usr/local/bin/omnipost desktop
Icon=omnipost
Terminal=false
Categories=Development;Utility;Publishing;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open OmniPost CLI
Exec=x-terminal-emulator -e "/usr/local/bin/omnipost --help"

[Desktop Action Web]
Name=Open Web UI (Port 8091)
Exec=/usr/local/bin/omnipost web
